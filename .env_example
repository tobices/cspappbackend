# Server Configuration
PORT=5000
NODE_ENV=development

# Database - Choose ONE of these options:

# Option 1: Local MongoDB (if you have MongoDB installed locally)
MONGODB_URI=
# Option 2: MongoDB Atlas (cloud - recommended, free tier available)
# Go to https://www.mongodb.com/atlas to create a free cluster
# Then replace with your connection string
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cspapp?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=my-super-secret-jwt-key-change-this-in-production-12345
JWT_REFRESH_SECRET=my-super-secret-refresh-key-change-this-67890
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Paystack Payment (for now, use test keys)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=

# SMTP Email Configuration (for now, use placeholder)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# HollaTags SMS Configuration (for now, use placeholder)
# HollaTags SMS Configuration
HOLLATAGS_USERNAME=
HOLLATAGS_PASSWORD=
HOLLATAGS_SENDER_ID=
#HOLLATAGS_BASE_URL=

# Cloudinary (for now, use placeholder)
CLOUDINARY_CLOUD_NAME=test
CLOUDINARY_API_KEY=test
CLOUDINARY_API_SECRET=test

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100