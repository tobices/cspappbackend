{
  "name": "cspapp-backend",
  "version": "1.0.0",
  "description": "Church Management System Backend",
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./config": "./src/config/index.js",
    "./controllers": "./src/controllers/index.js",
    "./middleware": "./src/middleware/index.js",
    "./models": "./src/models/index.js",
    "./routes": "./src/routes/index.js",
    "./services": "./src/services/index.js",
    "./utils": "./src/utils/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "dev:debug": "nodemon --inspect src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "db:seed": "node scripts/seed.js",
    "db:drop": "node scripts/dropDatabase.js",
    "logs": "tail -f logs/$(date +%Y-%m-%d).log",
    "clean": "rm -rf node_modules package-lock.json && npm install"
  },
  "keywords": [
    "church-management",
    "cspapp",
    "backend",
    "api",
    "express",
    "mongodb"
  ],
  "author": "CSPAPP Church",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "pdfkit": "^0.14.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.4"
  }
}
